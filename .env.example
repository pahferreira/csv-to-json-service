# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored and excluded from the Docker build context.
#
# PORT is required and has no default: Cloud Run always injects it, so
# defaulting it would only hide a misconfigured deploy (ADR-0011).
PORT=8080

# Optional. Defaults come from ADR-0005 and apply when a line is absent or
# empty. Ceilings are 10485760 bytes and 100000 rows.
# MAX_BYTES=2097152
# MAX_ROWS=10000

# Optional. One of DEBUG, INFO, WARN, ERROR (case-insensitive). Default INFO.
# LOG_LEVEL=INFO
